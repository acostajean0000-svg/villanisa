---
/**
 * Banda promocional superior — el espacio que en los portales ocupa un
 * anunciante, aquí trabajando para la casa.
 *
 * SuperCasas vende ese rectángulo a una feria hipotecaria; Villanisa no tiene
 * anunciantes, tiene inventario. Así que la banda promociona la puerta de
 * entrada más ancha del negocio: el precio mínimo real y los proyectos con
 * Bono de Primera Vivienda. Los dos datos salen del inventario en cada
 * build — el "desde US$X" nunca se queda viejo ni promete algo que no existe.
 *
 * El enlace usa los parámetros del buscador (?pmax=100000): la banda no
 * inventa una página nueva, aterriza en el filtro que ya funciona.
 */
import {
  getAllProperties,
  getTasaDOP,
  usdOf,
  precioPlausible,
  isForSale,
} from '../lib/alterestate';

const props = await getAllProperties();
const tasa = await getTasaDOP();

const preciosVenta = props
  .filter((p) => isForSale(p) && precioPlausible(p, tasa))
  .map((p) => usdOf(p, tasa))
  .filter((n): n is number => n !== null && n > 0)
  .sort((a, b) => a - b);

const desde = preciosVenta[0] ?? null;
const desdeTexto = desde ? `US$${Math.round(desde).toLocaleString('en-US')}` : null;

// Cuántas fichas mencionan el bono: si el CRM deja de ofrecerlo, la banda
// deja de prometerlo sola.
const conBono = props.filter((p) =>
  /bono/i.test(`${p.name ?? ''} ${p.short_description ?? ''}`)
).length;

const asequibles = preciosVenta.filter((n) => n <= 100_000).length;
---

{
  desdeTexto && asequibles > 0 && (
    <aside class="container-x mt-5" aria-label="Promoción">
      <a
        href="/propiedades/?pmax=100000"
        class="promo group relative block overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-brand-700)] text-white"
      >
        {/* Perfil de ciudad dibujado, no una foto: cero riesgo de que salga
            un retrato del CRM en el lugar más visible del sitio. Se desplaza
            lentísimo para que la banda respire. */}
        <svg
          class="skyline pointer-events-none absolute bottom-0 left-0 h-[72%] w-[200%] text-white/[0.07]"
          viewBox="0 0 1200 160"
          preserveAspectRatio="none"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M0 160V96h34V60h14v36h22V78h30v82h24V44h12l6-16 6 16h12v116h30V88h40v72h22V36h44v124h26v-58h36v58h20V70h16V52h26v18h16v90h34V98h46v62h24V30h10l7-18 7 18h10v130h32v-70h38v70h22V84h42v76h26V56h36v104h28v-44h34v44h22V92h40v68h26V48h12l6-14 6 14h12v112h30v-62h38v62Z" />
        </svg>
        <span class="pointer-events-none absolute inset-y-0 right-0 w-1/3 bg-gradient-to-l from-[var(--color-brand-500)]/40 to-transparent" aria-hidden="true" />

        <span class="relative flex flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-5 md:px-10 md:py-6">
          <span class="flex min-w-0 flex-col gap-1.5">
            {conBono >= 3 && (
              <span class="w-fit rounded-full bg-[var(--color-gold-500)] px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-white">
                Aplica Bono Primera Vivienda
              </span>
            )}
            <span class="font-[var(--font-display)] text-[clamp(1.3rem,2.6vw,1.9rem)] leading-tight">
              Tu primera vivienda está aquí
            </span>
            <span class="text-[0.95rem] text-white/80">
              <strong class="font-semibold text-white">{asequibles} propiedades</strong> hasta
              US$100,000, desde <strong class="font-semibold text-white">{desdeTexto}</strong>
              — verificadas por nuestro equipo.
            </span>
          </span>

          <span class="btn shrink-0 !bg-white !text-[var(--color-brand-700)] transition-transform group-hover:scale-[1.03]">
            Ver las {asequibles} →
          </span>
        </span>
      </a>
    </aside>
  )
}

<style>
  /* La ciudad avanza un 8% en 40 s, ida y vuelta: apenas perceptible, pero
     suficiente para que la banda no parezca una imagen pegada. */
  .skyline {
    animation: pasear 40s ease-in-out infinite alternate;
  }
  @keyframes pasear {
    to {
      transform: translateX(-8%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skyline {
      animation: none;
    }
  }
</style>
