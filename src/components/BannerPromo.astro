---
/**
 * Banda promocional superior — el espacio que en los portales ocupa un
 * anunciante, aquí trabajando para la casa.
 *
 * SuperCasas vende ese rectángulo a una feria hipotecaria; Villanisa no tiene
 * anunciantes, tiene inventario. Así que la banda promociona la puerta de
 * entrada más ancha del negocio: el precio mínimo real y los proyectos con
 * Bono de Primera Vivienda. Los dos datos salen del inventario en cada
 * build — el "desde US$X" nunca se queda viejo ni promete algo que no existe.
 *
 * El enlace usa los parámetros del buscador (?pmax=100000): la banda no
 * inventa una página nueva, aterriza en el filtro que ya funciona.
 */
import {
  getAllProperties,
  getTasaDOP,
  usdOf,
  precioPlausible,
  isForSale,
} from '../lib/alterestate';

const props = await getAllProperties();
const tasa = await getTasaDOP();

const preciosVenta = props
  .filter((p) => isForSale(p) && precioPlausible(p, tasa))
  .map((p) => usdOf(p, tasa))
  .filter((n): n is number => n !== null && n > 0)
  .sort((a, b) => a - b);

const desde = preciosVenta[0] ?? null;
const desdeTexto = desde ? `US$${Math.round(desde).toLocaleString('en-US')}` : null;

// Cuántas fichas mencionan el bono: si el CRM deja de ofrecerlo, la banda
// deja de prometerlo sola.
const conBono = props.filter((p) =>
  /bono/i.test(`${p.name ?? ''} ${p.short_description ?? ''}`)
).length;

const asequibles = preciosVenta.filter((n) => n <= 100_000).length;
---

{
  desdeTexto && asequibles > 0 && (
    <aside class="border-b border-[var(--border)] bg-[var(--color-brand-700)]" aria-label="Promoción">
      <a
        href="/propiedades/?pmax=100000"
        class="container-x group flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3 text-white"
      >
        <p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 text-[0.92rem]">
          {conBono >= 3 && (
            <span class="rounded-full bg-[var(--color-gold-500)] px-2.5 py-0.5 text-[0.72rem] font-semibold uppercase tracking-wide text-white">
              Bono Primera Vivienda
            </span>
          )}
          <span class="font-medium">
            Tu primera vivienda está aquí: {asequibles}
            {asequibles === 1 ? ' propiedad' : ' propiedades'} hasta US$100,000
          </span>
          <span class="hidden text-white/70 sm:inline">· desde {desdeTexto}</span>
        </p>
        <span class="whitespace-nowrap text-[0.88rem] text-[var(--color-brand-200)] underline-offset-4 group-hover:underline">
          Verlas →
        </span>
      </a>
    </aside>
  )
}
