---
const year = new Date().getFullYear();

const oficinas = [
  {
    nombre: 'Villanisa Central',
    direccion: 'Calle General Carlos Hernández #67, Los Prados, Santo Domingo',
    tel: '+1 (809) 328-3379',
    telHref: '+18093283379',
  },
  {
    nombre: 'Villanisa Oriental',
    direccion: 'Av. Charles de Gaulle, Plaza David Antonio, local 2-11',
    tel: '+1 (809) 745-5466',
    telHref: '+18097455466',
  },
];

const columnas = [
  {
    titulo: 'Comprar',
    links: [
      { href: '/propiedades/', label: 'Todas las propiedades' },
      { href: '/propiedades/?tipo=apartamentos', label: 'Apartamentos' },
      { href: '/propiedades/?tipo=casas', label: 'Casas' },
      { href: '/propiedades/?tipo=villas', label: 'Villas' },
    ],
  },
  {
    titulo: 'Villanisa',
    links: [
      { href: '/nosotros/', label: 'Nosotros' },
      { href: '/agentes/', label: 'Nuestros agentes' },
      { href: '/contacto/', label: 'Contacto' },
    ],
  },
];
---

<footer class="mt-28 border-t border-[var(--border)] bg-[var(--surface-raised)]">
  <div class="container-x py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <img
          src="/logo-villanisa.webp"
          srcset="/logo-villanisa.webp 1x, /logo-villanisa@2x.webp 2x"
          alt="Inmobiliaria Villanisa Group RD"
          width="231"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-12 w-auto"
        />
        <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-[var(--text-soft)]">
          Más de 25 años acompañando a familias dominicanas a comprar bien.
          Asesores, no vendedores.
        </p>
        {/* WhatsApp retirado hasta que exista el reparto por turnos. */}
        <a href="/contacto/" class="btn btn-ghost mt-6">Hablar con un asesor</a>
      </div>

      {
        columnas.map((col) => (
          <div>
            <p class="eyebrow">{col.titulo}</p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-[0.95rem] text-[var(--text-soft)] transition-colors hover:text-[var(--text)]">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 border-t border-[var(--border)] pt-10 sm:grid-cols-2">
      {
        oficinas.map((o) => (
          <div>
            <p class="text-[0.95rem] font-medium">{o.nombre}</p>
            <p class="mt-1.5 text-[0.9rem] leading-relaxed text-[var(--text-soft)]">{o.direccion}</p>
            <a href={`tel:${o.telHref}`} class="mt-1.5 inline-block text-[0.9rem] text-[var(--text-soft)] hover:text-[var(--text)]">
              {o.tel}
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[var(--border)] pt-8 text-[0.82rem] text-[var(--text-mute)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Villanisa. Todos los derechos reservados.</p>
      <p>Lun–Vie 8:00–17:00 · Sáb 8:00–12:00</p>
    </div>
  </div>
</footer>
