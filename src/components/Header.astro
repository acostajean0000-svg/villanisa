---
const nav = [
  { href: '/propiedades/', label: 'Propiedades' },
  { href: '/agentes/', label: 'Agentes' },
  { href: '/nosotros/', label: 'Nosotros' },
];
const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--surface)]/85 backdrop-blur-xl"
>
  <div class="container-x flex h-[68px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="Villanisa Group, inicio">
      <img
        src="/logo-villanisa.webp"
        srcset="/logo-villanisa.webp 1x, /logo-villanisa@2x.webp 2x"
        alt="Inmobiliaria Villanisa Group RD"
        width="231"
        height="120"
        fetchpriority="high"
        decoding="async"
        class="h-9 w-auto sm:h-10"
      />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {
        nav.map((item) => {
          const active = path === item.href || (item.href !== '/' && path.startsWith(item.href));
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3.5 py-2 text-[0.9rem] transition-colors',
                active
                  ? 'text-[var(--text)] font-medium'
                  : 'text-[var(--text-soft)] hover:text-[var(--text)]',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contacto/" class="btn btn-primary hidden sm:inline-flex">Hablemos</a>
      <button
        type="button"
        id="menu-btn"
        class="rounded-full border border-[var(--border)] p-2.5 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" hidden class="border-t border-[var(--border)] md:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Principal móvil">
      {
        nav.map((item) => (
          <a href={item.href} class="border-b border-[var(--border)] py-3.5 text-[var(--text-soft)] last:border-0">
            {item.label}
          </a>
        ))
      }
      <a href="/contacto/" class="btn btn-primary mt-3">Hablemos</a>
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-movil');
  btn?.addEventListener('click', () => {
    const open = menu.hasAttribute('hidden');
    open ? menu.removeAttribute('hidden') : menu.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
