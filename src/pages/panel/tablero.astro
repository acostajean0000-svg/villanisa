---
/**
 * Panel · Tablero — Fase 5.
 *
 * La vista del administrador: todos los leads, quién los tiene, en qué etapa
 * están y cuánto se tarda en contestar. Es lo que se mira en la reunión del
 * lunes, así que prioriza los números por asesor antes que la lista.
 */
import Base from '../../layouts/Base.astro';
import FichaLead from '../../components/FichaLead.astro';
import { identificar, aLaPuerta } from '../../lib/guardia';
import { listarAsesores } from '../../lib/ruleta';
import { medianaRespuesta } from '../../lib/leads';
import {
  ETAPAS,
  ETAPA_NOMBRE,
  ETAPAS_CERRADAS,
  embudo,
  esEtapa,
  equipoDe,
  leadsDeEquipo,
  notasDeVarios,
  todosLosLeads,
  type AsesorAcceso,
  type Etapa,
  type LeadCRM,
  type Nota,
} from '../../lib/crm';

export const prerender = false;

const quien = await identificar(Astro.request);
if (quien.tipo === 'nadie') return aLaPuerta('/panel/tablero/');
// Fase 6: el gerente también tiene tablero, pero solo de su equipo.
if (quien.tipo === 'asesor') return Astro.redirect('/panel/mis-leads/', 302);
const soloMiEquipo = quien.tipo === 'gerente';

Astro.response.headers.set('Cache-Control', 'no-store');

const filtroEtapa = Astro.url.searchParams.get('etapa');
const etapaFiltro: Etapa | null = esEtapa(filtroEtapa) ? filtroEtapa : null;
const filtroAsesor = Astro.url.searchParams.get('asesor');

let leads: LeadCRM[] = [];
let asesores: AsesorAcceso[] = [];
let notas = new Map<string, Nota[]>();
let error: string | null = null;

try {
  if (soloMiEquipo) {
    // El recorte se hace en la consulta, no filtrando después: un error en esta
    // plantilla no puede terminar enseñándole a un gerente el equipo de otro.
    asesores = await equipoDe(quien.asesor.id);
    leads = await leadsDeEquipo(asesores.map((a) => a.id), 500);
  } else {
    [leads, asesores] = await Promise.all([
      todosLosLeads(500),
      listarAsesores() as Promise<AsesorAcceso[]>,
    ]);
  }
} catch (err) {
  error = (err as Error).message;
}

const nombrePor = new Map(asesores.map((a) => [a.id, a.nombre]));
const cuenta = embudo(leads);
const abierto = (l: LeadCRM) => !ETAPAS_CERRADAS.includes((l.etapa ?? 'nuevo') as Etapa);

/** Una fila por asesor: carga abierta, cerrados y cuánto tarda en contestar. */
const porAsesor = asesores.filter((a) => a.rol !== 'gerente').map((a) => {
  const suyos = leads.filter((l) => l.asesor_id === a.id);
  return {
    asesor: a,
    total: suyos.length,
    abiertos: suyos.filter(abierto).length,
    sinAtender: suyos.filter((l) => !l.atendido_en).length,
    cerrados: suyos.filter((l) => l.etapa === 'cerrado').length,
    mediana: medianaRespuesta(suyos),
  };
});

// Los que la ruleta nunca tocó: llegaron antes de la Fase 4 o entraron cuando
// no había nadie disponible. Conviene verlos: son los que nadie está mirando.
// Solo administración: un gerente nunca ve leads sin dueño, porque su vista
// se construye a partir de los asesores de su equipo.
const huerfanos = soloMiEquipo ? [] : leads.filter((l) => !l.asesor_id);

let visibles = leads;
if (etapaFiltro) visibles = visibles.filter((l) => (l.etapa ?? 'nuevo') === etapaFiltro);
else visibles = visibles.filter(abierto);
if (filtroAsesor === 'sin') visibles = visibles.filter((l) => !l.asesor_id);
else if (filtroAsesor) visibles = visibles.filter((l) => l.asesor_id === filtroAsesor);

// Las notas se piden solo de lo que se va a pintar: con 500 leads en la tabla,
// traerlas todas sería la consulta más cara de la pantalla y nadie las vería.
if (!error) {
  try {
    notas = await notasDeVarios(visibles.slice(0, 100).map((l) => l.id));
  } catch {
    /* sin notas la ficha sigue sirviendo */
  }
}

const ir = `/panel/tablero/${Astro.url.search}`;
// Para el gerente esta lista ya ES su equipo; para administración, todos.
const paraReasignar = asesores
  .filter((a) => a.activo && a.rol !== 'gerente')
  .map((a) => ({ id: a.id, nombre: a.nombre }));

const enTiempo = (m: number | null) => (m === null ? '—' : m < 60 ? `${m} min` : `${Math.floor(m / 60)} h`);

// Resumen ejecutivo: los cuatro números que importan antes de mirar el detalle.
const totalSinAtender = leads.filter((l) => !l.atendido_en).length;
const totalCerrados = leads.filter((l) => l.etapa === 'cerrado').length;
const totalPerdidos = leads.filter((l) => l.etapa === 'perdido').length;
const decididos = totalCerrados + totalPerdidos;
const tasaCierre = decididos > 0 ? Math.round((totalCerrados / decididos) * 100) : null;

const ACENTO: Record<Etapa, string> = {
  nuevo: 'var(--color-brand-500)',
  contactado: 'var(--color-brand-500)',
  visita: '#8a5a12',
  negociacion: '#8a5a12',
  cerrado: '#2f8a4e',
  perdido: '#a52c2c',
};

const iniciales = (n: string) =>
  n.trim().split(/\s+/).slice(0, 2).map((p) => p[0]?.toUpperCase() ?? '').join('');

// Prioridad primero: quien tiene leads sin atender arriba de todo, y dentro de
// cada grupo, quien más carga abierta tiene — es el orden en que de verdad se
// revisa esta tabla en la reunión.
const porAsesorOrdenado = [...porAsesor].sort((a, b) =>
  b.sinAtender - a.sinAtender || b.abiertos - a.abiertos
);
---

<Base title="Tablero · Villanisa" description="Estado del pipeline." noindex={true}>
  <section class="container-x pt-12">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <p class="eyebrow">Interno</p>
        <h1 class="mt-3 text-[clamp(1.7rem,4vw,2.5rem)] leading-tight">
          {soloMiEquipo ? 'Mi equipo' : 'Tablero'}
        </h1>
        {soloMiEquipo && (
          <p class="mt-2 text-[0.95rem] text-[var(--text-soft)]">
            {quien.nombre} · {asesores.length} asesor{asesores.length === 1 ? '' : 'es'}
          </p>
        )}
      </div>
      <nav class="flex flex-wrap gap-3" aria-label="Accesos">
        {!soloMiEquipo && (
          <>
            <a href="/panel/asesores/" class="btn btn-ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Ruleta
            </a>
            <a href="/panel/leads/" class="btn btn-ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z"/></svg>
              Entrada de leads
            </a>
            <a href="/panel/meta/" class="btn btn-ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              Campañas de Meta
            </a>
            <a href="/panel/" class="btn btn-ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/></svg>
              Inventario
            </a>
          </>
        )}
        <a href="/panel/clave/" class="btn btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
          Mi clave
        </a>
        <a href="/api/entrar?salir=1" class="btn btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
          Salir
        </a>
      </nav>
    </div>
  </section>

  {error && (
    <section class="container-x mt-8">
      <div class="rounded-xl border border-[var(--color-gold-600)] bg-[#fdf3f3] p-5 text-[0.95rem]">
        <p class="font-semibold">No se pudo leer el tablero.</p>
        <p class="mt-2 text-[var(--text-soft)]">{error}</p>
      </div>
    </section>
  )}

  <!-- Resumen ejecutivo -->
  <section class="container-x mt-8">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="card p-4">
        <p class="eyebrow">En el pipeline</p>
        <p class="mt-2 font-[family-name:var(--font-display)] text-[1.7rem] leading-none">{leads.length}</p>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Sin atender</p>
        <p class={`mt-2 font-[family-name:var(--font-display)] text-[1.7rem] leading-none ${totalSinAtender > 0 ? 'text-[#a52c2c]' : ''}`}>
          {totalSinAtender}
        </p>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Cerrados</p>
        <p class="mt-2 font-[family-name:var(--font-display)] text-[1.7rem] leading-none text-[#2f8a4e]">{totalCerrados}</p>
      </div>
      <div class="card p-4">
        <p class="eyebrow">Tasa de cierre</p>
        <p class="mt-2 font-[family-name:var(--font-display)] text-[1.7rem] leading-none">
          {tasaCierre === null ? '—' : `${tasaCierre}%`}
        </p>
        <p class="mt-1 text-[0.78rem] text-[var(--text-mute)]">de los decididos</p>
      </div>
    </div>
  </section>

  <!-- Embudo -->
  <section class="container-x mt-8">
    <h2 class="text-[1.05rem] font-semibold text-[var(--text-soft)]">Embudo</h2>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {ETAPAS.map((e) => (
        <a
          href={`/panel/tablero/?etapa=${e}`}
          class={`card relative overflow-hidden p-4 transition-colors ${etapaFiltro === e ? 'border-[var(--color-brand-600)] bg-[var(--color-brand-50)]' : 'hover:border-[var(--text-mute)]'}`}
        >
          <span class="absolute inset-x-0 top-0 h-[3px]" style={{ background: ACENTO[e] }} aria-hidden="true"></span>
          <p class="font-[family-name:var(--font-display)] text-[1.6rem] leading-none">{cuenta[e]}</p>
          <p class="mt-1.5 text-[0.82rem] text-[var(--text-mute)]">{ETAPA_NOMBRE[e]}</p>
        </a>
      ))}
    </div>
    <p class="mt-3 text-[0.85rem]">
      <a class="underline underline-offset-4 text-[var(--text-soft)]" href="/panel/tablero/">Ver solo los abiertos</a>
      {huerfanos.length > 0 && (
        <>
          <span class="mx-2 text-[var(--text-mute)]">·</span>
          <a class="underline underline-offset-4 font-medium text-[#a52c2c]" href="/panel/tablero/?asesor=sin#leads">
            {huerfanos.length} sin asesor
          </a>
        </>
      )}
    </p>
  </section>

  <!-- Carga por asesor -->
  {porAsesor.length > 0 && (
    <section class="container-x mt-10">
      <h2 class="text-[1.05rem] font-semibold text-[var(--text-soft)]">Por asesor</h2>
      <div class="card mt-3 overflow-x-auto">
        <table class="w-full min-w-[38rem] border-collapse text-[0.92rem]">
          <thead>
            <tr class="border-b border-[var(--line)] text-left text-[var(--text-mute)]">
              <th class="py-3 pl-4 pr-4 font-medium">Asesor</th>
              <th class="py-3 pr-4 font-medium">Abiertos</th>
              <th class="py-3 pr-4 font-medium">Sin atender</th>
              <th class="py-3 pr-4 font-medium">Cerrados</th>
              <th class="py-3 pr-4 font-medium">Respuesta</th>
              <th class="py-3 pr-4 font-medium">Total</th>
              <th class="py-3 pr-4 font-medium">Conversión</th>
            </tr>
          </thead>
          <tbody>
            {porAsesorOrdenado.map((f) => (
              <tr class={`border-b border-[var(--line)] last:border-0 hover:bg-[var(--color-bone-100)] ${filtroAsesor === f.asesor.id ? 'bg-[var(--color-brand-50)]' : ''}`}>
                <td class="py-3 pl-4 pr-4">
                  <a href={`/panel/tablero/?asesor=${f.asesor.id}#leads`} class="flex items-center gap-3">
                    <span
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[0.75rem] font-semibold text-white"
                      style={{ background: f.asesor.activo ? 'var(--color-brand-500)' : 'var(--text-mute)' }}
                      aria-hidden="true"
                    >
                      {iniciales(f.asesor.nombre)}
                    </span>
                    <span class="underline-offset-4 hover:underline">
                      {f.asesor.nombre}
                      {!f.asesor.activo && <span class="ml-2 text-[0.78rem] font-normal text-[var(--text-mute)]">inactivo</span>}
                    </span>
                  </a>
                </td>
                <td class="py-3 pr-4 tabular-nums">{f.abiertos}</td>
                <td class="py-3 pr-4 tabular-nums">
                  {f.sinAtender > 0 ? (
                    <span class="inline-flex items-center rounded-full bg-[#fbeaea] px-2.5 py-0.5 text-[0.8rem] font-semibold text-[#a52c2c]">
                      {f.sinAtender}
                    </span>
                  ) : (
                    <span class="text-[var(--text-mute)]">0</span>
                  )}
                </td>
                <td class="py-3 pr-4 tabular-nums">{f.cerrados}</td>
                <td class="py-3 pr-4 tabular-nums">{enTiempo(f.mediana)}</td>
                <td class="py-3 pr-4 tabular-nums font-medium">{f.total}</td>
                <td class="py-3 pr-4">
                  <div class="flex items-center gap-2">
                    <div class="h-1.5 w-16 overflow-hidden rounded-full bg-[var(--color-bone-200)]">
                      <div
                        class="h-full rounded-full bg-[#2f8a4e]"
                        style={{ width: `${f.total ? Math.round((f.cerrados / f.total) * 100) : 0}%` }}
                      ></div>
                    </div>
                    <span class="text-[0.78rem] tabular-nums text-[var(--text-mute)]">
                      {f.total ? Math.round((f.cerrados / f.total) * 100) : 0}%
                    </span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-[0.82rem] text-[var(--text-mute)]">
        «Respuesta» es la mediana hasta el primer contacto, no el promedio: un caso
        olvidado no debe ensuciar el número de todo el equipo. Ordenado por quién
        tiene más leads sin atender primero.
      </p>
    </section>
  )}

  <section id="leads" class="container-x mt-10 scroll-mt-24 pb-24">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-[1.05rem] font-semibold text-[var(--text-soft)]">
        {etapaFiltro ? ETAPA_NOMBRE[etapaFiltro] : 'Leads abiertos'}
        <span class="ml-2 font-normal text-[var(--text-mute)]">({visibles.length})</span>
      </h2>
      {filtroAsesor && (
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-brand-50)] py-1 pl-3 pr-1.5 text-[0.82rem]">
          {filtroAsesor === 'sin' ? 'Sin asesor' : `Solo de ${nombrePor.get(filtroAsesor) ?? 'ese asesor'}`}
          <a
            href={`/panel/tablero/${etapaFiltro ? `?etapa=${etapaFiltro}` : ''}#leads`}
            class="flex h-5 w-5 items-center justify-center rounded-full bg-white/70 hover:bg-white"
            aria-label="Quitar filtro de asesor"
          >
            ×
          </a>
        </span>
      )}
    </div>
    {visibles.length === 0 ? (
      <p class="mt-4 rounded-xl border border-dashed border-[var(--line)] p-8 text-center text-[0.95rem] text-[var(--text-soft)]">
        No hay leads en este filtro.
      </p>
    ) : (
      <div class="mt-4 space-y-4">
        {visibles.slice(0, 100).map((l) => (
          <FichaLead
            lead={l}
            notas={notas.get(l.id) ?? []}
            ir={ir}
            asesores={paraReasignar}
            duenno={l.asesor_id ? (nombrePor.get(l.asesor_id) ?? 'asesor borrado') : 'sin asesor'}
          />
        ))}
      </div>
    )}
  </section>
</Base>
