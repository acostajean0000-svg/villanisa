---
/**
 * Panel · Poner o cambiar la clave — Fase 5b.
 *
 * Con `?t=` es la pantalla que abre el asesor invitado. Sin token, es el
 * cambio de clave de quien ya está dentro.
 *
 * No se indexa y no se cachea: lleva un token de un solo uso en la URL.
 */
import Base from '../../layouts/Base.astro';
import { identificar } from '../../lib/guardia';
import { asesorDeInvitacion } from '../../lib/invitacion';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
// Que el token no se le cuele a nadie por la cabecera Referer al pulsar un
// enlace desde esta página.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const token = (Astro.url.searchParams.get('t') ?? '').trim();
const e = Astro.url.searchParams.get('e');
const hecho = Astro.url.searchParams.get('ok') === '1';

let invitado: { nombre: string; correo: string | null } | null = null;
let quienSoy: string | null = null;

if (token) {
  const a = await asesorDeInvitacion(token);
  if (a) invitado = { nombre: a.nombre, correo: a.correo };
} else {
  const quien = await identificar(Astro.request);
  if (quien.tipo === 'nadie' || !quien.asesor) return Astro.redirect('/panel/entrar/', 302);
  quienSoy = quien.nombre;
}

const MENSAJE: Record<string, string> = {
  corta: 'La clave necesita al menos 8 caracteres.',
  larga: 'Esa clave es demasiado larga.',
  distintas: 'Las dos claves no coinciden.',
  actual: 'La clave actual no es correcta.',
  invitacion: 'Este enlace ya se usó o venció. Pida uno nuevo a administración.',
  servidor: 'No se pudo guardar. Intente de nuevo.',
  formulario: 'No se recibió el formulario. Intente de nuevo.',
};
const error = e ? (MENSAJE[e] ?? MENSAJE.servidor) : null;

// Un token que no vale: no se enseña el formulario, no tendría a quién guardar.
const invitacionRota = Boolean(token) && !invitado;
---

<Base title="Su clave · Villanisa" description="Acceso del equipo." noindex={true}>
  <section class="container-x flex min-h-[70vh] items-center justify-center py-16">
    <div class="w-full max-w-sm">
      <p class="eyebrow">Equipo Villanisa</p>
      <h1 class="mt-3 text-[1.8rem] leading-tight">
        {invitado ? 'Elija su clave' : 'Cambiar mi clave'}
      </h1>

      {invitado && (
        <p class="mt-3 text-[0.95rem] text-[var(--text-soft)]">
          Hola, {invitado.nombre}. Va a entrar con <strong>{invitado.correo}</strong> y la
          clave que escriba aquí. Nadie más la va a ver, ni siquiera administración.
        </p>
      )}
      {quienSoy && (
        <p class="mt-3 text-[0.95rem] text-[var(--text-soft)]">{quienSoy}</p>
      )}

      {hecho && (
        <p class="mt-5 rounded-lg border border-[var(--line)] bg-[#f2f7f2] px-4 py-3 text-[0.9rem]">
          Clave cambiada.
        </p>
      )}

      {error && (
        <p role="alert" class="mt-5 rounded-lg border border-[var(--color-gold-600)] bg-[#fdf3f3] px-4 py-3 text-[0.9rem]">
          {error}
        </p>
      )}

      {invitacionRota ? (
        <div class="mt-6 text-[0.95rem] text-[var(--text-soft)]">
          <p>
            Este enlace ya no sirve: o se usó, o pasaron los siete días, o la cuenta
            está desactivada.
          </p>
          <p class="mt-3">
            Pídale a administración que le mande uno nuevo. Si ya tiene clave,
            <a class="underline underline-offset-4" href="/panel/entrar/"> entre por aquí</a>.
          </p>
        </div>
      ) : (
        <form method="post" action="/api/clave" class="mt-6 space-y-4">
          {token && <input type="hidden" name="t" value={token} />}

          {!token && (
            <label class="block">
              <span class="text-[0.85rem] font-medium">Clave actual</span>
              <input
                type="password"
                name="actual"
                required
                autocomplete="current-password"
                class="mt-1 w-full rounded-lg border border-[var(--line)] px-3 py-2.5 text-[1rem]"
              />
            </label>
          )}

          <label class="block">
            <span class="text-[0.85rem] font-medium">Clave nueva</span>
            <input
              type="password"
              name="clave"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1 w-full rounded-lg border border-[var(--line)] px-3 py-2.5 text-[1rem]"
            />
          </label>

          <label class="block">
            <span class="text-[0.85rem] font-medium">Repítala</span>
            <input
              type="password"
              name="repetida"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1 w-full rounded-lg border border-[var(--line)] px-3 py-2.5 text-[1rem]"
            />
          </label>

          <button
            type="submit"
            class="w-full rounded-lg bg-[var(--color-brand-600)] px-4 py-3 font-medium text-white"
          >
            Guardar
          </button>
        </form>
      )}

      <p class="mt-6 text-[0.85rem] text-[var(--text-mute)]">
        Mínimo 8 caracteres. Use algo que no use en otro sitio.
      </p>
    </div>
  </section>
</Base>
