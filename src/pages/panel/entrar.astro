---
/**
 * Panel · Entrar — Fase 5.
 *
 * Pantalla de acceso del asesor. Sin JavaScript: es un formulario que postea
 * a /api/entrar. Una pantalla de login que depende de JS es una pantalla que
 * un día no carga y deja al equipo fuera.
 */
import Base from '../../layouts/Base.astro';
import { identificar } from '../../lib/guardia';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

// Quien ya entró no tiene nada que hacer aquí.
const quien = await identificar(Astro.request);
if (quien.tipo !== 'nadie') {
  return Astro.redirect(quien.tipo === 'admin' ? '/panel/tablero/' : '/panel/mis-leads/', 302);
}

const ir = Astro.url.searchParams.get('ir') ?? '';
const e = Astro.url.searchParams.get('e');

const MENSAJE: Record<string, string> = {
  '1': 'Correo o clave incorrectos.',
  '2': 'Demasiados intentos. Espere unos minutos y vuelva a probar.',
  '3': 'No se pudo consultar la base de datos. Intente de nuevo en un momento.',
  '4': 'Falta configurar el secreto de sesión en el servidor. Avise a administración.',
};
const error = e ? (MENSAJE[e] ?? MENSAJE['1']) : null;
---

<Base title="Entrar · Villanisa" description="Acceso del equipo comercial." noindex={true}>
  <section class="container-x flex min-h-[70vh] items-center justify-center py-16">
    <div class="w-full max-w-sm">
      <p class="eyebrow">Equipo Villanisa</p>
      <h1 class="mt-3 text-[1.8rem] leading-tight">Entrar</h1>
      <p class="mt-3 text-[0.95rem] text-[var(--text-soft)]">
        Use el correo con el que está dado de alta en la ruleta.
      </p>

      {error && (
        <p
          role="alert"
          class="mt-5 rounded-lg border border-[var(--color-gold-600)] bg-[#fdf3f3] px-4 py-3 text-[0.9rem]"
        >
          {error}
        </p>
      )}

      <form method="post" action="/api/entrar" class="mt-6 space-y-4">
        <input type="hidden" name="ir" value={ir} />

        <label class="block">
          <span class="text-[0.85rem] font-medium">Correo</span>
          <input
            type="email"
            name="correo"
            required
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            class="mt-1 w-full rounded-lg border border-[var(--line)] px-3 py-2.5 text-[1rem]"
          />
        </label>

        <label class="block">
          <span class="text-[0.85rem] font-medium">Clave</span>
          <input
            type="password"
            name="clave"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-lg border border-[var(--line)] px-3 py-2.5 text-[1rem]"
          />
        </label>

        <button
          type="submit"
          class="w-full rounded-lg bg-[var(--color-brand-600)] px-4 py-3 font-medium text-white"
        >
          Entrar
        </button>
      </form>

      <p class="mt-6 text-[0.85rem] text-[var(--text-mute)]">
        ¿No tiene clave todavía? Pídasela a administración: se asigna desde la
        pantalla de asesores.
      </p>
    </div>
  </section>
</Base>
