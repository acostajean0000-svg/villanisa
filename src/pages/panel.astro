---
/**
 * Panel de operación — Fase 1 del sistema propio.
 *
 * Lee el inventario en vivo desde AlterEstate en el navegador, así que
 * siempre muestra el estado real sin depender de un despliegue. La página
 * servida no contiene datos: todo se calcula en el cliente.
 *
 * No se enlaza desde el sitio ni se indexa.
 */
import Base from '../layouts/Base.astro';

// La página deja de ser estática: se genera por petición para poder exigir
// credenciales antes de devolver nada.
export const prerender = false;

/**
 * Autenticación básica HTTP. El navegador muestra su propio diálogo y el
 * servidor no entrega ni un byte del panel sin credenciales correctas.
 * No es un sistema de usuarios — es una puerta con llave para una
 * herramienta interna, que es justo lo que hace falta aquí.
 */
/**
 * Lee una variable de entorno tanto en ejecución como en build.
 *
 * Vercel expone las variables marcadas como "Sensitive" SOLO en tiempo de
 * ejecución, mientras que `import.meta.env` se resuelve al construir. Sin
 * esta doble lectura, marcar la clave como sensible la dejaría vacía.
 */
const env = (clave: string): string | undefined => {
  const enEjecucion =
    typeof process !== 'undefined' && process.env ? process.env[clave] : undefined;
  return enEjecucion ?? (import.meta.env as Record<string, string | undefined>)[clave];
};

const USUARIO = env('PANEL_USUARIO') || 'villanisa';
const CLAVE = env('PANEL_CLAVE');

const pedirClave = () =>
  new Response('Acceso restringido', {
    status: 401,
    headers: {
      'WWW-Authenticate': 'Basic realm="Panel Villanisa", charset="UTF-8"',
      'Cache-Control': 'no-store',
    },
  });

// Sin clave configurada se cierra el paso. Fallar cerrado, nunca abierto:
// un despliegue mal configurado no debe dejar el panel al aire.
if (!CLAVE) {
  return new Response(
    'El panel no tiene clave configurada. Define PANEL_CLAVE en las variables de entorno.',
    { status: 503, headers: { 'Cache-Control': 'no-store' } }
  );
}

const cabecera = Astro.request.headers.get('authorization') ?? '';
const [tipo, credencial] = cabecera.split(' ');

let autorizado = false;
if (tipo?.toLowerCase() === 'basic' && credencial) {
  try {
    const [u, c] = atob(credencial).split(':');
    // Comparación de tiempo constante: no revela la clave por cronometraje
    const iguales = (a = '', b = '') => {
      if (a.length !== b.length) return false;
      let dif = 0;
      for (let i = 0; i < a.length; i++) dif |= a.charCodeAt(i) ^ b.charCodeAt(i);
      return dif === 0;
    };
    autorizado = iguales(u, USUARIO) && iguales(c, CLAVE);
  } catch {
    autorizado = false;
  }
}

if (!autorizado) return pedirClave();

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base
  title="Panel de operación"
  description="Estado del inventario y calidad de datos de Villanisa."
  noindex={true}
>
  <section class="container-x pt-12">
    <p class="eyebrow">Interno</p>
    <h1 class="mt-3 text-[clamp(1.9rem,4vw,2.8rem)] leading-tight">Panel de operación</h1>
    <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-[var(--text-soft)]">
      Estado del inventario en tiempo real, leído directamente del CRM.
      Cada problema listado es una propiedad que hoy rinde por debajo de lo que podría.
    </p>
    <p id="estado" class="mt-4 text-[0.9rem] text-[var(--text-mute)]" role="status" aria-live="polite">
      Cargando inventario…
    </p>
  </section>

  <div id="panel" hidden>
    <!-- Indicadores -->
    <section class="container-x mt-10">
      <div id="kpis" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8"></div>
    </section>

    <!-- Salud de los datos -->
    <section class="container-x mt-16">
      <h2 class="text-[1.6rem]">Qué está frenando el inventario</h2>
      <p class="mt-3 max-w-2xl text-[0.98rem] text-[var(--text-soft)]">
        Ordenado por impacto. Corregir esto en AlterEstate se refleja en el sitio
        en la siguiente sincronización.
      </p>
      <div id="problemas" class="mt-8 space-y-4"></div>
    </section>

    <!-- Distribuciones -->
    <section class="container-x mt-16 grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-[1.4rem]">Por tipo</h2>
        <div id="por-tipo" class="mt-6 space-y-3"></div>
      </div>
      <div>
        <h2 class="text-[1.4rem]">Por ciudad</h2>
        <div id="por-ciudad" class="mt-6 space-y-3"></div>
      </div>
    </section>

    <!-- Redactor de descripciones -->
    <section class="container-x mt-16">
      <h2 class="text-[1.6rem]">Editor de descripciones</h2>
      <p class="mt-3 max-w-2xl text-[0.98rem] leading-relaxed text-[var(--text-soft)]">
        Los textos que guardes aquí <strong class="text-[var(--text)]">viven en el
        almacenamiento de Villanisa, no en AlterEstate</strong>, y mandan sobre lo que
        venga del CRM. Para las propiedades sin texto se propone un borrador armado
        con sus datos reales: edítalo y añade siempre algo que solo sepa quien vio
        la propiedad. Al guardar, el sitio se republica solo.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button id="btn-desc" class="btn btn-primary">Cargar propiedades</button>
        <button id="btn-guardar" class="btn btn-ghost" hidden>Guardar cambios</button>
        <label class="flex items-center gap-2 text-[0.9rem] text-[var(--text-soft)]">
          <input type="checkbox" id="solo-faltan" checked /> Solo las que no tienen texto
        </label>
      </div>
      <p id="progreso-desc" class="mt-4 text-[0.9rem] text-[var(--text-mute)]" role="status" aria-live="polite"></p>
      <div id="descripciones" class="mt-6 space-y-4"></div>
    </section>

    <!-- Calidad de fotos: bajo demanda porque mide cada imagen -->
    <section class="container-x mt-16">
      <h2 class="text-[1.6rem]">Calidad de las fotos</h2>
      <p class="mt-3 max-w-2xl text-[0.98rem] text-[var(--text-soft)]">
        Mide la resolución real del archivo original de cada portada. Las de menos
        de 1000 px de ancho suelen venir reenviadas por WhatsApp y nunca se verán bien.
      </p>
      <button id="btn-fotos" class="btn btn-primary mt-6">Analizar las portadas</button>
      <p id="progreso-fotos" class="mt-4 text-[0.9rem] text-[var(--text-mute)]"></p>
      <div id="fotos" class="mt-6"></div>
    </section>

    <section class="container-x mt-16">
      <p class="text-[0.85rem] text-[var(--text-mute)]">
        Datos leídos en vivo de la API de AlterEstate. Esta página no se indexa ni se enlaza desde el sitio.
      </p>
    </section>
  </div>
</Base>

<script>
  const API = 'https://secure.alterestate.com/api/v1';
  const DOMAIN = 'villanisainmobiliaria.com';
  const cab = { domain: DOMAIN, Accept: 'application/json' };

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const num = (n: number) => n.toLocaleString('es-DO');
  const dinero = (n: number | null) =>
    n ? 'US$' + Math.round(n).toLocaleString('en-US') : '—';

  interface Prop {
    uid: string; slug: string; name: string;
    featured_image?: string;
    category?: { name: string };
    city?: string; sector?: string;
    sale_price?: number | null; rent_price?: number | null;
    currency_sale?: string | null; currency_rent?: string | null;
    room?: number | null; bathroom?: number | null;
    property_area?: number | null;
    short_description?: string;
    description?: string;
  }

  let props: Prop[] = [];
  let tasa = 58;

  // Más de la mitad del inventario está en pesos: sin convertir, cualquier
  // estadística de precio es basura.
  async function cargarTasa() {
    try {
      const r = await fetch('https://open.er-api.com/v6/latest/USD');
      const j = await r.json();
      const t = j?.rates?.DOP;
      if (typeof t === 'number' && t > 20 && t < 200) tasa = t;
    } catch { /* nos quedamos con el respaldo */ }
  }

  const enUSD = (p: Prop) => {
    const monto = p.sale_price || p.rent_price || 0;
    const moneda = (p.sale_price ? p.currency_sale : p.currency_rent) || 'USD';
    return moneda === 'DOP' ? monto / tasa : monto;
  };

  async function cargar() {
    const todas: Prop[] = [];
    let url: string | null = `${API}/properties/filter/?country=149&page=1`;
    let guard = 0;
    while (url && guard++ < 50) {
      const r: Response = await fetch(url, { headers: cab });
      if (!r.ok) break;
      const j: { results?: Prop[]; next?: string } = await r.json();
      todas.push(...(j.results ?? []));
      url = j.next ?? null;
      $('#estado').textContent = `Cargando inventario… ${todas.length} propiedades`;
    }
    return todas;
  }

  /* ------------------------------------------------------------ indicadores */
  function tarjeta(k: string, v: string, nota = '', estado: 'ok' | 'aviso' | 'malo' = 'ok') {
    const color = estado === 'malo' ? '#d03b3b' : estado === 'aviso' ? '#b8791a' : 'var(--text)';
    return `<div class="card p-4">
      <p class="eyebrow">${k}</p>
      <p class="mt-2 font-[family-name:var(--font-display)] text-[1.7rem] leading-none" style="color:${color}">${v}</p>
      ${nota ? `<p class="mt-1.5 text-[0.78rem] text-[var(--text-mute)]">${nota}</p>` : ''}
    </div>`;
  }

  function barras(datos: [string, number][], total: number) {
    const max = Math.max(...datos.map((d) => d[1]), 1);
    return datos
      .map(([etiqueta, n]) => `
        <div>
          <div class="flex items-baseline justify-between gap-3 text-[0.9rem]">
            <span>${etiqueta}</span>
            <span class="tabular-nums text-[var(--text-mute)]">${n} · ${Math.round((n / total) * 100)}%</span>
          </div>
          <div class="mt-1.5 h-1.5 rounded-full bg-[var(--color-bone-200)]">
            <div class="h-full rounded-full bg-[var(--color-brand-500)]" style="width:${(n / max) * 100}%"></div>
          </div>
        </div>`)
      .join('');
  }

  function agrupar(campo: (p: Prop) => string | undefined) {
    const m = new Map<string, number>();
    for (const p of props) {
      const k = campo(p);
      if (!k) continue;
      m.set(k, (m.get(k) ?? 0) + 1);
    }
    return [...m.entries()].sort((a, b) => b[1] - a[1]);
  }

  function bloqueProblema(titulo: string, lista: Prop[], porque: string) {
    if (!lista.length) return '';
    const pct = Math.round((lista.length / props.length) * 100);
    const grave = pct >= 25;
    return `<details class="card p-5">
      <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
        <span class="font-medium">${titulo}</span>
        <span class="shrink-0 rounded-full px-3 py-1 text-[0.8rem] font-semibold"
              style="background:${grave ? '#fbeaea' : '#fdf4e3'};color:${grave ? '#a52c2c' : '#8a5a12'}">
          ${lista.length} · ${pct}%
        </span>
      </summary>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-[var(--text-soft)]">${porque}</p>
      <ul class="mt-4 max-h-72 space-y-1.5 overflow-y-auto text-[0.85rem]">
        ${lista.slice(0, 60).map((p) => `
          <li>
            <a href="https://${DOMAIN}/propiedad/${p.slug}" target="_blank" rel="noopener"
               class="text-[var(--text-soft)] underline-offset-4 hover:text-[var(--text)] hover:underline">
              ${p.name || p.slug}
            </a>
            <span class="text-[var(--text-mute)]">— ${[p.sector, p.city].filter(Boolean).join(', ') || 'sin ubicación'}</span>
          </li>`).join('')}
      </ul>
      ${lista.length > 60 ? `<p class="mt-3 text-[0.8rem] text-[var(--text-mute)]">…y ${lista.length - 60} más</p>` : ''}
    </details>`;
  }

  function pintar() {
    const total = props.length;
    const precios = props.map(enUSD).filter(Boolean).sort((a, b) => a - b);
    const mediana = precios.length ? precios[Math.floor(precios.length / 2)] : null;
    // Mediana y con filtro de cordura: un área mal cargada distorsiona la media.
    const ratios = props
      .filter((p) => p.property_area && enUSD(p))
      .map((p) => enUSD(p) / p.property_area!)
      .filter((r) => r > 200 && r < 10000)
      .sort((a, b) => a - b);
    const m2 = ratios.length ? ratios[Math.floor(ratios.length / 2)] : null;
    const enPesos = props.filter((p) => (p.sale_price ? p.currency_sale : p.currency_rent) === 'DOP').length;

    const sinFoto = props.filter((p) => !p.featured_image);
    const sinPrecio = props.filter((p) => !p.sale_price && !p.rent_price);
    const sinSector = props.filter((p) => !p.sector);
    const sinArea = props.filter((p) => !p.property_area);
    const sinHab = props.filter((p) => !p.room && p.category?.name !== 'Solares');
    const sinDesc = props.filter((p) => (p.short_description || '').replace(/<[^>]*>/g, '').trim().length < 80);
    // Errores de tecleo en el precio: se detectan al convertir a dólares
    const precioImposible = props.filter((p) => enUSD(p) > 10000000);
    const nombrePobre = props.filter((p) => {
      const n = (p.name || '').trim();
      return n.length < 22 || /^(apartamento|casa|villa|propiedad)(\s+(en|de)\s+venta)?$/i.test(n);
    });
    const avenida = props.filter((p) => /^(aut\.?|autopista|av\.?|avenida|prolongaci[oó]n|carretera)/i.test(p.sector ?? ''));

    $('#kpis').innerHTML = [
      tarjeta('Propiedades', num(total)),
      tarjeta('Precio mediano', dinero(mediana), 'normalizado a USD'),
      tarjeta('Mediana por m²', dinero(m2)),
      tarjeta('Sin foto', num(sinFoto.length), 'no se pueden mostrar', sinFoto.length ? 'malo' : 'ok'),
      tarjeta('Sin precio', num(sinPrecio.length), 'no salen en filtros', sinPrecio.length ? 'aviso' : 'ok'),
      tarjeta('Sin sector', num(sinSector.length), 'sin página de zona', sinSector.length ? 'aviso' : 'ok'),
      tarjeta('Publicadas en RD$', num(enPesos), `tasa ${tasa.toFixed(2)}`),
      tarjeta('Precio imposible', num(precioImposible.length), 'ceros de más', precioImposible.length ? 'malo' : 'ok'),
    ].join('');

    $('#problemas').innerHTML = [
      bloqueProblema('Sin imagen de portada', sinFoto,
        'Una ficha sin foto prácticamente no recibe clics. Es lo primero a corregir.'),
      bloqueProblema('Precio imposible — ceros de más', precioImposible,
        'Convertido a dólares supera los 10 millones. Casi siempre es un error de tecleo en el CRM. Como el listado ordena por precio, estos errores se quedaban con el primer lugar de la página.'),
      bloqueProblema('Sin precio publicado', sinPrecio,
        'Quedan fuera de todos los filtros por presupuesto y no aparecen con precio en Google.'),
      bloqueProblema('Nombre genérico o demasiado corto', nombrePobre,
        'El sitio arma el título para Google desde los datos, pero un buen nombre ayuda en el CRM, en portales y en WhatsApp.'),
      bloqueProblema('Sin sector asignado', sinSector,
        'No entran en ninguna página de zona, que es donde está el tráfico de búsquedas locales.'),
      bloqueProblema('Sector es una avenida, no un sector', avenida,
        'Nadie busca "apartamentos en Aut. Duarte". Cambiar por el sector real convierte cada una en tráfico aprovechable.'),
      bloqueProblema('Sin metros cuadrados', sinArea,
        'Sin área no se puede calcular precio por m², que es como compara todo comprador informado.'),
      bloqueProblema('Sin habitaciones', sinHab,
        'Quedan fuera del filtro más usado del sitio.'),
      bloqueProblema('Descripción muy corta o vacía', sinDesc,
        'Google necesita texto propio para posicionar la ficha, y el comprador para decidir si vale la visita.'),
    ].join('');

    $('#por-tipo').innerHTML = barras(agrupar((p) => p.category?.name), total);
    $('#por-ciudad').innerHTML = barras(agrupar((p) => p.city).slice(0, 10), total);
  }

  /* --------------------------------------------- borradores de descripción */

  const listar = (xs: string[]) =>
    xs.length === 1 ? xs[0] : xs.slice(0, -1).join(', ') + ' y ' + xs[xs.length - 1];

  /**
   * El campo de amenidades del CRM viene mezclado: junto a "piscina" o "gimnasio"
   * hay etiquetas comerciales ("alta rentabilidad"), materiales ("acero") y datos
   * que ya damos estructurados ("3 habitaciones", "4 niveles"). Publicar eso como
   * amenidad produce frases como "entre sus amenidades: acero", que leen a
   * descuido. Filtramos antes de redactar; el dato sigue en el CRM intacto.
   */
  const RUIDO =
    /^(\d|acero|hormig[oó]n|block|alta rentabilidad|rentabilidad|oportunidad|inversi[oó]n|financiamiento|bono|nivel|niveles|ba[ñn]o|ba[ñn]os|habitaci[oó]n|habitaciones|parqueo|parqueos|metros?|m2|m²)\b/i;

  const amenidadesUtiles = (xs: string[]) =>
    xs.map((a) => (a || '').trim()).filter((a) => a.length > 2 && !RUIDO.test(a));

  /**
   * Compone un borrador a partir de datos estructurados.
   *
   * Se varían las aperturas y los cierres según la propiedad para que 101
   * fichas no acaben con el mismo párrafo — texto calcado en masa perjudica
   * más de lo que ayuda. Aun así, lo que de verdad posiciona y vende es la
   * frase que añade el asesor, no la plantilla.
   */
  function borrador(p: any, amenidades: string[]) {
    const tipo = (p.category?.name || 'Propiedad').replace(/s$/, '');
    const donde = [p.sector, p.city].filter(Boolean).join(', ');
    const i = (p.cid || 0) % 4;

    const aperturas = [
      `${tipo} en venta en ${donde}.`,
      `Disponible en ${donde}: ${tipo.toLowerCase()} en venta.`,
      `Te presentamos este ${tipo.toLowerCase()} ubicado en ${donde}.`,
      `Oportunidad en ${donde}: ${tipo.toLowerCase()} en venta.`,
    ];

    const ficha = [
      p.room ? `${p.room} ${p.room === 1 ? 'habitación' : 'habitaciones'}` : null,
      p.bathroom ? `${p.bathroom} ${p.bathroom === 1 ? 'baño' : 'baños'}` : null,
      p.half_bathrooms ? `${p.half_bathrooms} medio baño` : null,
      p.parkinglot ? `${p.parkinglot} ${p.parkinglot === 1 ? 'parqueo' : 'parqueos'}` : null,
    ].filter(Boolean) as string[];

    const partes: string[] = [aperturas[i]];

    if (ficha.length) {
      partes.push(
        `Cuenta con ${listar(ficha)}${p.property_area ? ` en ${p.property_area} m² de construcción` : ''}.`
      );
    } else if (p.property_area) {
      partes.push(`Tiene ${p.property_area} m² de construcción.`);
    }

    if (p.terrain_area) partes.push(`El terreno mide ${p.terrain_area} m².`);
    if (p.floor_level) partes.push(`Ubicado en el nivel ${p.floor_level}${p.total_floors ? ` de ${p.total_floors}` : ''}.`);
    if (p.year_construction) partes.push(`Construido en ${p.year_construction}.`);

    if (amenidades.length) {
      partes.push(`Entre sus amenidades: ${listar(amenidades.slice(0, 8)).toLowerCase()}.`);
    }

    const cierres = [
      `Agenda tu visita con un asesor de Villanisa y conócelo en persona.`,
      `Escríbenos y coordinamos una visita sin compromiso.`,
      `Un asesor de Villanisa puede mostrarte esta y otras opciones en ${p.sector || p.city || 'la zona'}.`,
      `Contáctanos para conocer las facilidades de pago disponibles.`,
    ];
    partes.push(cierres[i]);

    return partes.join(' ');
  }

  let overrides: Record<string, { descripcion?: string; titulo?: string; actualizado?: string }> = {};
  const editados = new Set<string>();

  async function cargarOverrides() {
    try {
      const r = await fetch('/api/contenido');
      if (!r.ok) return;
      const j = await r.json();
      if (j.ok) overrides = j.overrides || {};
    } catch { /* seguimos sin textos propios */ }
  }

  function ficha(p: any, texto: string, propio: boolean) {
    const donde = [p.sector, p.city].filter(Boolean).join(', ');
    const sello = propio
      ? '<span class="ml-2 rounded-full bg-[#eaf3ee] px-2.5 py-0.5 text-[0.72rem] font-semibold text-[#12402f]">texto propio</span>'
      : '<span class="ml-2 rounded-full bg-[#fdf4e3] px-2.5 py-0.5 text-[0.72rem] font-semibold text-[#8a5a12]">borrador</span>';
    return `<details class="card p-5" data-uid="${p.uid}">
      <summary class="cursor-pointer list-none font-medium">${p.name || p.slug}${sello}
        <span class="ml-1 text-[0.82rem] font-normal text-[var(--text-mute)]">${donde}</span>
      </summary>
      <textarea class="txt mt-4 w-full rounded-xl border border-[var(--border-control)] bg-[var(--surface)] p-4 text-[0.9rem] leading-relaxed"
                rows="6">${texto.replace(/</g, '&lt;')}</textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-[0.8rem] text-[var(--text-mute)]">
        <span class="cuenta"></span>
        <a target="_blank" rel="noopener" class="underline underline-offset-4"
           href="/propiedades/${p.slug}/">Ver en el sitio</a>
        ${overrides[p.uid]?.actualizado ? `<span>Editado ${new Date(overrides[p.uid].actualizado!).toLocaleDateString('es-DO')}</span>` : ''}
      </div>
    </details>`;
  }

  async function cargarEditor() {
    const btn = $('#btn-desc') as HTMLButtonElement;
    btn.disabled = true;
    await cargarOverrides();

    const soloFaltan = ($('#solo-faltan') as HTMLInputElement).checked;
    const objetivo = props.filter((p) => {
      const tienePropio = Boolean(overrides[p.uid]?.descripcion);
      const tieneCRM = (p.short_description || '').replace(/<[^>]*>/g, '').trim().length >= 80;
      return soloFaltan ? !tienePropio && !tieneCRM : true;
    });

    const partes: string[] = [];
    let hechas = 0;

    for (let i = 0; i < objetivo.length; i += 4) {
      const lote = objetivo.slice(i, i + 4);
      const detalles = await Promise.all(
        lote.map((p) =>
          overrides[p.uid]?.descripcion
            ? Promise.resolve(null)
            : fetch(`${API}/properties/view/${encodeURIComponent(p.slug)}/`, { headers: cab })
                .then((r) => (r.ok ? r.json() : null))
                .catch(() => null)
        )
      );

      lote.forEach((p, k) => {
        const propio = overrides[p.uid]?.descripcion;
        let texto = propio ?? '';
        if (!texto) {
          const d = detalles[k] || p;
          const am = Array.isArray(d.amenities)
            ? d.amenities.map((a: any) => (typeof a === 'string' ? a : a?.name)).filter(Boolean)
            : [];
          /**
           * El listado solo trae `short_description`, pero la ficha pública
           * muestra `description`. Una propiedad con 900 caracteres de texto
           * bueno en el CRM aparecía aquí como vacía, con un borrador
           * genérico encima; guardarlo SUSTITUÍA la descripción real, porque
           * el texto propio manda sobre el del CRM. Ahora que llega la ficha
           * completa, comprobamos el campo de verdad antes de proponer nada.
           */
          const textoCRM = (d.description || d.short_description || '')
            .replace(/<[^>]*>/g, '')
            .trim();
          texto = textoCRM.length >= 80 ? textoCRM : borrador(d, amenidadesUtiles(am));
        }
        partes.push(ficha(p, texto, Boolean(propio)));
        hechas++;
      });

      $('#progreso-desc').textContent = `Preparadas ${hechas} de ${objetivo.length}…`;
    }

    $('#descripciones').innerHTML = partes.join('');
    $('#progreso-desc').textContent = `${objetivo.length} propiedades listas para editar.`;
    ($('#btn-guardar') as HTMLElement).hidden = false;

    document.querySelectorAll('#descripciones textarea').forEach((t) => {
      const ta = t as HTMLTextAreaElement;
      const cuenta = (ta.closest('details') as HTMLElement).querySelector('.cuenta') as HTMLElement;
      const refrescar = () => {
        const n = ta.value.trim().split(/\s+/).filter(Boolean).length;
        cuenta.textContent = `${n} palabras${n < 40 ? ' — corta para posicionar' : ''}`;
      };
      refrescar();
      ta.addEventListener('input', () => {
        refrescar();
        editados.add((ta.closest('details') as HTMLElement).dataset.uid!);
        ($('#btn-guardar') as HTMLElement).textContent = `Guardar ${editados.size} ${editados.size === 1 ? 'cambio' : 'cambios'}`;
      });
    });

    btn.disabled = false;
  }

  async function guardar() {
    const btn = $('#btn-guardar') as HTMLButtonElement;
    if (!editados.size) {
      $('#progreso-desc').textContent = 'No hay cambios que guardar.';
      return;
    }
    btn.disabled = true;
    $('#progreso-desc').textContent = 'Guardando…';

    const cambios: Record<string, { descripcion: string }> = {};
    editados.forEach((uid) => {
      const d = document.querySelector(`#descripciones details[data-uid="${uid}"] textarea`) as HTMLTextAreaElement;
      if (d) cambios[uid] = { descripcion: d.value.trim() };
    });

    try {
      const r = await fetch('/api/contenido', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cambios }),
      });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || 'error');
      $('#progreso-desc').textContent =
        `${j.escritos} textos guardados (${j.total} en total). Republicación: ${j.despliegue}. Aparecen en el sitio en un par de minutos.`;
      editados.clear();
      btn.textContent = 'Guardar cambios';
    } catch (e) {
      $('#progreso-desc').textContent = `No se pudo guardar: ${(e as Error).message}`;
    }
    btn.disabled = false;
  }

  /* ------------------------------------------- resolución real de las fotos */
  function urlOriginal(url: string) {
    try {
      const m = url.match(/^(https?:\/\/[^/]+)\/(.+)$/)!;
      const p = JSON.parse(atob(m[2]));
      return `${m[1]}/${btoa(JSON.stringify({ bucket: p.bucket, key: p.key }))}`;
    } catch { return url; }
  }

  const medir = (url: string) => new Promise<number>((res) => {
    const im = new Image();
    im.onload = () => res(im.naturalWidth);
    im.onerror = () => res(0);
    im.src = url;
    setTimeout(() => res(0), 12000);
  });

  async function analizarFotos() {
    const btn = $('#btn-fotos') as HTMLButtonElement;
    btn.disabled = true;
    const conFoto = props.filter((p) => p.featured_image);
    const bajas: { p: Prop; w: number }[] = [];
    let hechas = 0;

    // De ocho en ocho: rápido sin saturar el navegador
    for (let i = 0; i < conFoto.length; i += 8) {
      const lote = conFoto.slice(i, i + 8);
      const anchos = await Promise.all(lote.map((p) => medir(urlOriginal(p.featured_image!))));
      lote.forEach((p, k) => {
        hechas++;
        if (anchos[k] > 0 && anchos[k] < 1000) bajas.push({ p, w: anchos[k] });
      });
      $('#progreso-fotos').textContent = `Analizadas ${hechas} de ${conFoto.length}…`;
    }

    $('#progreso-fotos').textContent =
      `${bajas.length} de ${conFoto.length} portadas están por debajo de 1000 px de ancho.`;

    $('#fotos').innerHTML = bajas.length
      ? `<div class="card overflow-hidden">
          <table class="w-full text-[0.88rem]">
            <thead><tr class="border-b border-[var(--border)]">
              <th class="p-3 text-left font-medium">Propiedad</th>
              <th class="p-3 text-left font-medium">Ubicación</th>
              <th class="p-3 text-right font-medium">Ancho real</th>
            </tr></thead>
            <tbody>${bajas.sort((a, b) => a.w - b.w).map((x) => `
              <tr class="border-b border-[var(--border)] last:border-0">
                <td class="p-3"><a href="https://${DOMAIN}/propiedad/${x.p.slug}" target="_blank" rel="noopener" class="underline-offset-4 hover:underline">${x.p.name}</a></td>
                <td class="p-3 text-[var(--text-soft)]">${[x.p.sector, x.p.city].filter(Boolean).join(', ')}</td>
                <td class="p-3 text-right tabular-nums ${x.w < 800 ? 'text-[#d03b3b]' : 'text-[var(--text-soft)]'}">${x.w} px</td>
              </tr>`).join('')}</tbody>
          </table>
        </div>`
      : '<p class="text-[0.95rem] text-[var(--text-soft)]">Ninguna portada por debajo del umbral. Buen trabajo del equipo.</p>';
    btn.disabled = false;
  }

  (async () => {
    try {
      await cargarTasa();
      props = await cargar();
      if (!props.length) throw new Error('sin datos');
      $('#estado').textContent =
        `${props.length} propiedades · actualizado ${new Date().toLocaleString('es-DO')}`;
      $('#panel').hidden = false;
      pintar();
      $('#btn-fotos').addEventListener('click', analizarFotos);
      $('#btn-desc').addEventListener('click', cargarEditor);
      $('#btn-guardar').addEventListener('click', guardar);
    } catch (e) {
      $('#estado').textContent =
        'No se pudo leer el inventario del CRM. Revisa la conexión e intenta de nuevo.';
    }
  })();
</script>
