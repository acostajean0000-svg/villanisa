---
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import {
  getAllProperties,
  priceOf,
  slugify,
  getTasaDOP,
  usdOf,
  toUSD,
  precioPlausible,
  precioMostrable,
  isForSale,
  getZonasConDatos,
  BANDAS_PRECIO_USD,
  type ZonaPublicada,
} from '../../lib/alterestate';

const props = await getAllProperties();
// Buena parte del inventario está en pesos: normalizamos para ordenar y filtrar.
const tasa = await getTasaDOP();

// Ordenar: con foto primero, luego por precio descendente. Una cuadrícula que
// abre con fotos vacías destruye la percepción de calidad.
const ordenadas = [...props].sort((a, b) => {
  // Los precios imposibles van al final: siguen visibles para poder detectarlos,
  // pero no se quedan con el primer lugar de la cuadrícula.
  const raro = (x: typeof a) => (precioPlausible(x, tasa) ? 0 : 1);
  if (raro(a) !== raro(b)) return raro(a) - raro(b);
  const foto = (x: typeof a) => (x.featured_image ? 0 : 1);
  if (foto(a) !== foto(b)) return foto(a) - foto(b);
  return (usdOf(b, tasa) ?? 0) - (usdOf(a, tasa) ?? 0);
});

const tipos = [...new Set(props.map((p) => p.category?.name).filter(Boolean))].sort() as string[];
const ciudades = [...new Set(props.map((p) => p.city).filter(Boolean))].sort() as string[];

// Sectores con su ciudad: el select de sector se acorta al elegir ciudad.
const sectores = [...new Map(
  props
    .filter((p) => p.sector)
    .map((p) => [slugify(p.sector!), { nombre: p.sector!, ciudad: slugify(p.city ?? '') }])
).entries()].sort((a, b) => a[1].nombre.localeCompare(b[1].nombre, 'es'));

const enVentaN = props.filter((p) => isForSale(p)).length;
const enAlquilerN = props.length - enVentaN;

// Hub de enlaces internos: desde aquí Google alcanza cada página de zona.
/**
 * Se enlazan sector Y ciudad.
 *
 * Antes solo se construían enlaces desde `p.sector`, pero las páginas de
 * ciudad también se generaban. Resultado: doce páginas existían y ninguna
 * recibía un solo enlace del sitio — entre ellas
 * /apartamentos-en-venta/santo-domingo-d-n/ con 58 propiedades, que es la
 * consulta cabecera del mercado. Sin enlaces internos no reciben ni autoridad
 * ni contexto de anclaje.
 */
const todasLasZonas: ZonaPublicada[] = await getZonasConDatos();
const zonas = todasLasZonas.filter((z: ZonaPublicada) => !z.esCiudad);
const ciudades_zonas = todasLasZonas.filter((z: ZonaPublicada) => z.esCiudad);

const total = props.length;
const descripcion = `${total} propiedades en venta en República Dominicana: apartamentos, casas, villas y proyectos en planos en Santo Domingo, Punta Cana y más. Villanisa, 25 años asesorando compradores.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Propiedades en venta',
  description: descripcion,
  url: 'https://villanisa.com.do/propiedades/',
  numberOfItems: total,
};
---

<Base
  title="Propiedades en venta en República Dominicana"
  description={descripcion}
  schema={schema}
>
  <section class="container-x pt-14">
    <p class="eyebrow">Inventario</p>
    <h1 class="mt-3 max-w-3xl text-[clamp(2.2rem,5vw,3.6rem)] leading-[1.06]">
      Propiedades en venta en República&nbsp;Dominicana
    </h1>
    <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-[var(--text-soft)]">
      {total} propiedades verificadas por nuestro equipo. Filtra por tipo, ciudad y presupuesto.
    </p>
  </section>

  <!-- Filtros: sin framework, puro HTML + un script corto. La portada envía
       aquí sus parámetros, así que este es el ÚNICO motor de filtrado. -->
  <section class="container-x sticky top-[76px] z-30 mt-10 border-y border-[var(--border)] bg-[var(--surface)]/95 py-4 backdrop-blur-xl">
    <div class="flex flex-wrap items-center gap-2.5">
      <select id="f-op" aria-label="Operación" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Comprar o alquilar</option>
        <option value="venta">Comprar ({enVentaN})</option>
        {enAlquilerN > 0 && <option value="alquiler">Alquilar ({enAlquilerN})</option>}
      </select>

      <select id="f-tipo" aria-label="Tipo de propiedad" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Todos los tipos</option>
        {tipos.map((t) => <option value={slugify(t)}>{t}</option>)}
      </select>

      <select id="f-ciudad" aria-label="Ciudad" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Todas las ciudades</option>
        {ciudades.map((c) => <option value={slugify(c)}>{c}</option>)}
      </select>

      <select id="f-sector" aria-label="Sector" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Todos los sectores</option>
        {sectores.map(([slug, s]) => <option value={slug} data-ciudad={s.ciudad}>{s.nombre}</option>)}
      </select>

      <select id="f-hab" aria-label="Habitaciones" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Habitaciones</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
      </select>

      <select id="f-banos" aria-label="Baños" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Baños</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
      </select>

      <select id="f-pmin" aria-label="Precio desde" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Desde</option>
        {BANDAS_PRECIO_USD.map((b) => <option value={b.v}>{b.l}</option>)}
      </select>

      <select id="f-pmax" aria-label="Precio hasta" class="rounded-full border border-[var(--border-control)] bg-[var(--surface-raised)] px-4 py-2.5 text-[0.9rem]">
        <option value="">Hasta</option>
        {BANDAS_PRECIO_USD.map((b) => <option value={b.v}>{b.l}</option>)}
      </select>

      <button id="f-reset" type="button" class="rounded-full px-3 py-2.5 text-[0.88rem] text-[var(--text-mute)] underline-offset-4 hover:underline">
        Limpiar
      </button>

      <p id="f-count" class="ml-auto text-[0.88rem] text-[var(--text-soft)]" role="status" aria-live="polite">
        {total} propiedades
      </p>
    </div>
  </section>

  <section class="container-x mt-12">
    <div id="grid" class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        ordenadas.map((p, i) => (
          <div
            class="prop"
            data-tipo={slugify(p.category?.name ?? '')}
            data-ciudad={slugify(p.city ?? '')}
            data-sector={slugify(p.sector ?? '')}
            data-hab={p.room ?? 0}
            data-banos={p.bathroom ?? 0}
            data-precio={(() => {
              // El filtro usa el MISMO precio que muestra la tarjeta. Con
              // usdOf crudo, la ficha de US$119 salía en "Hasta US$100k"
              // enseñando "Precio a consultar", y la de RD$8,500,000,000 en
              // "US$400k+". Filtrar por presupuesto devolvía justo las fichas
              // cuyo precio no nos creemos.
              const m = precioMostrable(p, tasa);
              return m ? Math.round(toUSD(m, priceOf(p).currency, tasa)) : '';
            })()}
            data-venta={isForSale(p) ? '1' : '0'}
          >
            <PropertyCard property={p} tasa={tasa} eager={i < 3} />
          </div>
        ))
      }
    </div>

    <p id="vacio" hidden class="py-24 text-center text-[var(--text-soft)]">
      No hay propiedades con esos criterios.
      <button id="vacio-reset" class="ml-1 underline underline-offset-4">Ver todas</button>
    </p>
  </section>

  {
    ciudades_zonas.length > 0 && (
      <section class="container-x mt-24">
        <h2 class="text-[1.6rem]">Buscar por ciudad</h2>
        <p class="mt-3 max-w-2xl text-[0.98rem] text-[var(--text-soft)]">
          El inventario completo de cada ciudad, con precios de referencia y áreas típicas.
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          {ciudades_zonas.map((z: ZonaPublicada) => (
            <a
              href={z.href}
              class="rounded-full border border-[var(--border)] px-4.5 py-2.5 text-[0.9rem] transition-colors hover:border-[var(--color-brand-500)] hover:text-[var(--color-brand-500)]"
            >
              {z.tipo} en {z.zona}
              <span class="ml-1.5 text-[var(--text-mute)]">{z.n}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    zonas.length > 0 && (
      <section class="container-x mt-24">
        <h2 class="text-[1.6rem]">Buscar por zona</h2>
        <p class="mt-3 max-w-2xl text-[0.98rem] text-[var(--text-soft)]">
          Cada zona tiene su propia página con precios, áreas típicas y el inventario completo.
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          {zonas.map((z: ZonaPublicada) => (
            <a
              href={z.href}
              class="rounded-full border border-[var(--border)] px-4.5 py-2.5 text-[0.9rem] transition-colors hover:border-[var(--color-brand-500)] hover:text-[var(--color-brand-500)]"
            >
              {z.tipo} en {z.zona}
              <span class="ml-1.5 text-[var(--text-mute)]">{z.n}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const op = $('#f-op') as HTMLSelectElement;
  const tipo = $('#f-tipo') as HTMLSelectElement;
  const ciudad = $('#f-ciudad') as HTMLSelectElement;
  const sector = $('#f-sector') as HTMLSelectElement;
  const hab = $('#f-hab') as HTMLSelectElement;
  const banos = $('#f-banos') as HTMLSelectElement;
  const pmin = $('#f-pmin') as HTMLSelectElement;
  const pmax = $('#f-pmax') as HTMLSelectElement;
  const count = $('#f-count');
  const vacio = $('#vacio');
  const items = [...document.querySelectorAll<HTMLElement>('.prop')];
  const controles = [op, tipo, ciudad, sector, hab, banos, pmin, pmax];

  /**
   * El sector obedece a la ciudad: al elegir una, el select de sector se
   * queda solo con los sectores de esa ciudad. Y si el que estaba elegido ya
   * no pertenece, se limpia — mantenerlo daría cero resultados sin explicar
   * por qué.
   */
  function acotarSectores() {
    const c = ciudad.value;
    let elegidoVive = false;
    for (const o of [...sector.options].slice(1)) {
      const fuera = Boolean(c) && o.dataset.ciudad !== c;
      o.hidden = fuera;
      if (o.value === sector.value && !fuera) elegidoVive = true;
    }
    if (sector.value && !elegidoVive) sector.value = '';
  }

  /**
   * El presupuesto solo aplica a compra. Los alquileres se publican por mes,
   * así que cruzarlos con bandas de precio de venta daría siempre cero:
   * mejor apagar el control que dejar una trampa.
   */
  function acotarPrecio() {
    const alquiler = op.value === 'alquiler';
    for (const s of [pmin, pmax]) {
      s.disabled = alquiler;
      if (alquiler) s.value = '';
    }
  }

  function aplicar() {
    acotarSectores();
    acotarPrecio();
    const min = pmin.value ? Number(pmin.value) : 0;
    const max = pmax.value ? Number(pmax.value) : Infinity;
    let visibles = 0;

    for (const el of items) {
      const d = el.dataset;
      // Sin precio (cadena vacía) queda fuera de cualquier tramo: antes valía
      // cero y se colaba en "Hasta US$100k".
      const p = d.precio === '' || d.precio == null ? null : Number(d.precio);
      const filtraPrecio = Boolean(pmin.value || pmax.value);
      const ok =
        (!op.value || d.venta === (op.value === 'venta' ? '1' : '0')) &&
        (!tipo.value || d.tipo === tipo.value) &&
        (!ciudad.value || d.ciudad === ciudad.value) &&
        (!sector.value || d.sector === sector.value) &&
        (!hab.value || Number(d.hab) >= Number(hab.value)) &&
        (!banos.value || Number(d.banos) >= Number(banos.value)) &&
        (!filtraPrecio || (p !== null && p >= min && p <= max));

      el.hidden = !ok;
      if (ok) visibles++;
    }

    count.textContent = `${visibles} ${visibles === 1 ? 'propiedad' : 'propiedades'}`;
    vacio.hidden = visibles > 0;

    // Refleja los filtros en la URL para que el usuario pueda compartirla
    const params = new URLSearchParams();
    if (op.value) params.set('op', op.value);
    if (tipo.value) params.set('tipo', tipo.value);
    if (ciudad.value) params.set('ciudad', ciudad.value);
    if (sector.value) params.set('sector', sector.value);
    if (hab.value) params.set('hab', hab.value);
    if (banos.value) params.set('banos', banos.value);
    if (pmin.value) params.set('pmin', pmin.value);
    if (pmax.value) params.set('pmax', pmax.value);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function limpiar() {
    controles.forEach((el) => (el.value = ''));
    aplicar();
  }

  controles.forEach((el) => el.addEventListener('change', aplicar));
  $('#f-reset').addEventListener('click', limpiar);
  document.getElementById('vacio-reset')?.addEventListener('click', limpiar);

  // Estado inicial desde la URL (la portada enlaza con estos parámetros)
  const p = new URLSearchParams(location.search);
  if (p.get('op')) op.value = p.get('op')!;
  if (p.get('tipo')) tipo.value = p.get('tipo')!;
  if (p.get('ciudad')) ciudad.value = p.get('ciudad')!;
  if (p.get('sector')) sector.value = p.get('sector')!;
  if (p.get('hab')) hab.value = p.get('hab')!;
  if (p.get('banos')) banos.value = p.get('banos')!;
  if (p.get('pmin')) pmin.value = p.get('pmin')!;
  if (p.get('pmax')) pmax.value = p.get('pmax')!;
  // Compatibilidad con los enlaces viejos (?precio=100000-200000): se
  // traducen a desde/hasta para que sigan funcionando compartidos.
  if (p.get('precio')) {
    const [a, b] = p.get('precio')!.split('-');
    if (a && Number(a) > 0) pmin.value = a;
    if (b && Number(b) < 99999999) pmax.value = b;
  }
  if ([...p.keys()].length) aplicar();
  else acotarSectores();
</script>
