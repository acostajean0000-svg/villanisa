---
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import Gallery from '../../components/Gallery.astro';
import {
  getAllProperties,
  getProperty,
  formatPrice,
  priceOf,
  imageOf,
  galleryOf,
  namesOf,
  aeImage,
  slugify,
  aeSrcSet,
  claveImagen,
  isForSale,
  getZonasPublicadas,
  getTasaDOP,
  precioPublico,
  type PropertyListItem,
} from '../../lib/alterestate';
import { getOverrides } from '../../lib/contenido';
import { limpiarHTML } from '../../lib/html';

export async function getStaticPaths() {
  const props = await getAllProperties();
  return props
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { listItem: p } }));
}

const { slug } = Astro.params;
const { listItem } = Astro.props as { listItem: PropertyListItem };

/**
 * La ficha completa trae galería, amenidades y agente. Pero para las
 * propiedades cargadas como proyecto (~40% del inventario) el endpoint de
 * detalle devuelve `sale_price`, `room`, `property_area` y `listing_type` en
 * nulo: los datos reales solo viven en el listado.
 *
 * Al usar `detail` a secas, esas fichas llevaban desde la publicación
 * mostrando "Precio a consultar" y una ficha técnica con una sola fila —
 * mientras la tarjeta que el visitante acababa de pulsar decía US$85,000,
 * 3 habitaciones y 96 m². Es la peor fuga de conversión del sitio y no la vio
 * ninguna revisión de código, porque hay que comparar tarjeta contra ficha.
 *
 * Fusionamos: el detalle manda donde tiene dato, el listado rellena el resto.
 */
const conDato = (v: unknown) =>
  v !== null && v !== undefined && v !== '' && !(Array.isArray(v) && v.length === 0);

const fusionar = (base: Record<string, any>, encima: Record<string, any>) => {
  const out: Record<string, any> = { ...base };
  for (const [k, v] of Object.entries(encima)) if (conDato(v)) out[k] = v;
  return out;
};

const ficha = await getProperty(slug!);
const detail = fusionar(listItem as any, (ficha ?? {}) as any) as any;

/**
 * El precio y su moneda vienen del MISMO sitio, siempre.
 *
 * Fusionar campo a campo los desacopla: en una propiedad de proyecto el
 * detalle trae `sale_price: null` pero `currency_sale: "RD"`, y el listado
 * trae `sale_price: 85000, currency_sale: "US"`. Mezclados daban RD$85,000
 * donde son US$85,000 — el precio equivocado por un factor de 58.
 */
const fuentePrecio: any =
  conDato(ficha?.sale_price) || conDato((ficha as any)?.rent_price) ? ficha : listItem;
detail.sale_price = fuentePrecio?.sale_price ?? null;
detail.rent_price = fuentePrecio?.rent_price ?? null;
detail.currency_sale = fuentePrecio?.currency_sale ?? null;
detail.currency_rent = fuentePrecio?.currency_rent ?? null;

// El texto editado por el equipo manda sobre el que venga del CRM.
const overrides = await getOverrides();
const propio = overrides[detail.uid] ?? {};
const descripcionFinal = propio.descripcion
  ? `<p>${propio.descripcion.replace(/\n{2,}/g, '</p><p>').replace(/\n/g, '<br />')}</p>`
  // El texto del CRM se escribe en un editor y se inserta como HTML: hay que
  // limpiarlo antes. Ver src/lib/html.ts.
  : limpiarHTML(detail.description);

const { amount, currency } = priceOf(detail);
// Se necesita la tasa para juzgar si un precio en pesos es plausible.
const tasaFicha = await getTasaDOP();
const precio = precioPublico(detail, tasaFicha);
const portada = imageOf(detail);
const galeria = galleryOf(detail);
// La portada puede o no venir dentro de la galería: unimos sin duplicar.
// Dedupe por la key del bucket, no por la URL: la portada llega por un CDN y
// la misma foto dentro de la galería por otro, así que como cadenas nunca
// coincidían y el visor abría con la primera imagen repetida.
const fotos = (() => {
  const vistas = new Set<string>();
  const out: string[] = [];
  for (const u of [imageOf(detail), ...galeria]) {
    if (!u) continue;
    const k = claveImagen(u);
    if (vistas.has(k)) continue;
    vistas.add(k);
    out.push(u);
  }
  return out;
})();
const amenidades = namesOf(detail.amenities);
const agente = detail.agents?.[0];
const ubicacion = [detail.sector, detail.city].filter(Boolean).join(', ');

const tipo = detail.category?.name ?? 'Propiedad';

/**
 * Los nombres que escriben los agentes en el CRM no sirven para posicionar:
 * "Apartamento en venta", "✨ Moderno apartamento con terraza", "Torre Caney".
 * El <title> se arma siempre desde datos estructurados, con la forma que la
 * gente teclea en Google. El H1 conserva el nombre del agente solo si aporta.
 */
const especificaciones = [
  detail.room ? `${detail.room} hab` : null,
  detail.property_area ? `${detail.property_area} m²` : null,
].filter(Boolean).join(', ');

const enVenta = isForSale(detail as PropertyListItem);
const operacion = enVenta ? 'en venta' : 'en alquiler';
const base = `${tipo.replace(/s$/, '')} ${operacion} en ${ubicacion}`;

/**
 * Las especificaciones se añaden SIEMPRE, no solo cuando sobra espacio.
 *
 * La versión anterior las omitía si `base` pasaba de 46 caracteres, para no
 * exceder el corte visual de Google. El efecto real fue peor que el problema
 * que evitaba: 23 de cada 60 fichas acabaron compartiendo título exacto con
 * otra —cinco propiedades distintas como "Apartamento en venta en Aut.
 * Duarte, Santo Domingo Oeste"—, compitiendo entre sí por la misma consulta.
 * Un título recortado en pantalla sigue siendo único para el índice.
 */
const tituloSEO = [base, especificaciones].filter(Boolean).join(' — ');

/** El CRM trae emoji, comillas y adornos: fuera del H1. */
const limpiarNombre = (s: string) =>
  s
    .replace(/[\p{Extended_Pictographic}\u{FE0F}\u{20E3}]/gu, '')
    .replace(/["""'']/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const nombreDelEquipo = limpiarNombre(propio.titulo || detail.name || '');
const nombreGenerico = /^(apartamento|casa|villa|propiedad)(\s+(en|de)\s+(venta|alquiler))?$/i.test(nombreDelEquipo);
const h1 = !nombreGenerico && nombreDelEquipo.length > 22 ? nombreDelEquipo : tituloSEO;

const titulo = tituloSEO;

// Enlace a la página de zona: cierra el circuito de enlazado interno
// Solo si la página de zona existe de verdad: se generan con 2+ propiedades
// en venta, así que enlazar a ciegas publicaba enlaces visibles a un 404 y una
// miga de pan estructurada rota.
const zonasQueExisten = await getZonasPublicadas();
const zonaHref = (() => {
  if (!enVenta || !detail.sector || !detail.category?.name) return null;
  const href = `/${slugify(detail.category.name)}-en-venta/${slugify(detail.sector)}/`;
  return zonasQueExisten.has(href) ? href : null;
})();
const descripcionPlana = (propio.descripcion || detail.description || detail.short_description || '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const metaDesc =
  descripcionPlana.slice(0, 155) ||
  `${tipo} en venta en ${ubicacion}. ${precio}. Villanisa, más de 25 años en el mercado inmobiliario dominicano.`;

const fichaTecnica = [
  { k: 'Tipo', v: tipo },
  { k: 'Habitaciones', v: detail.room },
  { k: 'Baños', v: detail.bathroom },
  { k: 'Medios baños', v: detail.half_bathrooms },
  { k: 'Parqueos', v: detail.parkinglot },
  { k: 'Área', v: detail.property_area ? `${detail.property_area} m²` : null },
  { k: 'Terreno', v: detail.terrain_area ? `${detail.terrain_area} m²` : null },
  { k: 'Nivel', v: detail.floor_level },
  { k: 'Año', v: detail.year_construction },
].filter((r) => r.v !== null && r.v !== undefined && r.v !== 0 && r.v !== '');

// Propiedades similares: mismo sector primero, luego misma ciudad.
const todas = await getAllProperties();
const similares = todas
  .filter((p) => p.uid !== detail.uid)
  .sort((a, b) => {
    const score = (x: PropertyListItem) =>
      (x.sector === detail.sector ? 2 : 0) + (x.city === detail.city ? 1 : 0);
    return score(b) - score(a);
  })
  .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: detail.name,
  description: metaDesc,
  url: new URL(`/propiedades/${slug}/`, Astro.site).href,
  image: fotos.slice(0, 8),
  datePosted: new Date().toISOString().split('T')[0],
  ...(amount && {
    offers: {
      '@type': 'Offer',
      price: amount,
      priceCurrency: currency,
      availability: 'https://schema.org/InStock',
      seller: { '@id': 'https://villanisa.com.do/#organization' },
    },
  }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: detail.city,
    addressRegion: detail.province ?? detail.city,
    addressCountry: 'DO',
  },
  ...(detail.room && { numberOfRooms: detail.room }),
  ...(detail.property_area && {
    floorSize: { '@type': 'QuantitativeValue', value: detail.property_area, unitCode: 'MTK' },
  }),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://villanisa.com.do/' },
    { '@type': 'ListItem', position: 2, name: 'Propiedades', item: 'https://villanisa.com.do/propiedades/' },
    ...(zonaHref
      ? [{ '@type': 'ListItem', position: 3, name: detail.sector, item: new URL(zonaHref, Astro.site).href }]
      : []),
    { '@type': 'ListItem', position: zonaHref ? 4 : 3, name: detail.name },
  ],
};
---

{/*
  La imagen para compartir se pide recortada a 1200x630 en el CDN.

  Antes se pasaba `portada` cruda: el original de cámara, de 2665x4000 y
  varios megabytes, con `og:image:width/height` declarando 1200x630 a mano.
  WhatsApp y Facebook recortaban una foto vertical a un marco horizontal —
  normalmente dejando el techo— y descargaban el archivo entero para hacerlo.
  Compartir una propiedad es de los gestos que más tráfico traen en este
  mercado, y era el peor sitio para servir la imagen sin procesar.
*/}
<Base
  title={titulo}
  description={metaDesc}
  image={aeImage(portada, 1200, { height: 630, fit: 'cover', quality: 80, format: 'jpeg' })}
  schema={[schema, breadcrumbs]}
>
  <article>
    <!-- Galería -->
    <section class="container-x pt-6">
      <nav aria-label="Ruta" class="mb-5 text-[0.82rem] text-[var(--text-mute)]">
        <a href="/" class="hover:text-[var(--text)]">Inicio</a>
        <span class="mx-1.5">/</span>
        <a href="/propiedades/" class="hover:text-[var(--text)]">Propiedades</a>
        {zonaHref && (
          <>
            <span class="mx-1.5">/</span>
            <a href={zonaHref} class="hover:text-[var(--text)]">{detail.sector}</a>
          </>
        )}
        <span class="mx-1.5">/</span>
        <span class="text-[var(--text-soft)]">{detail.name}</span>
      </nav>

      <Gallery fotos={fotos} titulo={titulo} />
    </section>

    <!-- Contenido -->
    <section class="container-x mt-12 grid gap-14 lg:grid-cols-[1.65fr_1fr]">
      <div>
        <p class="eyebrow">{tipo} en {ubicacion}</p>
        <h1 class="mt-3 text-[clamp(2rem,4.5vw,3rem)] leading-[1.08]">{h1}</h1>
        <p class="mt-4 font-[family-name:var(--font-display)] text-[2rem] text-[var(--color-gold-600)]">
          {precio}
        </p>

        {zonaHref && (
          <p class="mt-3 text-[0.92rem] text-[var(--text-soft)]">
            Ver <a href={zonaHref} class="underline underline-offset-4 hover:text-[var(--text)]">
              {tipo.toLowerCase()} en venta en {detail.sector}
            </a>
          </p>
        )}

        {
          fichaTecnica.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 border-y border-[var(--border)] py-8 sm:grid-cols-3">
              {fichaTecnica.map((r) => (
                <div>
                  <dt class="eyebrow">{r.k}</dt>
                  <dd class="mt-1 text-[1.05rem]">{r.v}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          descripcionFinal && (
            <div
              class="prose-villanisa mt-10 max-w-none text-[1.02rem] leading-relaxed text-[var(--text-soft)] [&_h2]:mt-8 [&_h2]:text-[1.3rem] [&_h2]:text-[var(--text)] [&_li]:mt-1.5 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5"
              set:html={descripcionFinal}
            />
          )
        }

        {
          amenidades.length > 0 && (
            <div class="mt-12">
              <h2 class="text-[1.4rem]">Amenidades</h2>
              <ul class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
                {amenidades.map((a) => (
                  <li class="flex items-start gap-2 text-[0.92rem] text-[var(--text-soft)]">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="mt-1 shrink-0 text-[var(--color-brand-500)]" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {a}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          detail.youtubeiframe && (
            <div class="mt-12">
              <h2 class="text-[1.4rem]">Video</h2>
              <div class="mt-5 aspect-video overflow-hidden rounded-[var(--radius-card)]" set:html={detail.youtubeiframe} />
            </div>
          )
        }

        {
          detail.mapiframe && (
            <div class="mt-12">
              <h2 class="text-[1.4rem]">Ubicación</h2>
              <div class="mt-5 aspect-[16/9] overflow-hidden rounded-[var(--radius-card)]" set:html={detail.mapiframe} />
            </div>
          )
        }
      </div>

      <!-- Columna de conversión -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="card p-6">
          {
            agente && (
              <div class="mb-6 flex items-center gap-3.5 border-b border-[var(--border)] pb-6">
                {agente.avatar && (
                  <img
                    src={aeImage(agente.avatar, 128, { height: 128, fit: 'cover' })}
                    alt={agente.full_name ?? 'Agente'}
                    width="52"
                    height="52"
                    loading="lazy"
                    class="h-13 w-13 rounded-full object-cover"
                  />
                )}
                <div>
                  <p class="font-medium">{agente.full_name}</p>
                  <p class="text-[0.82rem] text-[var(--text-mute)]">{agente.position ?? 'Asesor inmobiliario'}</p>
                </div>
              </div>
            )
          }

          <p class="font-[family-name:var(--font-display)] text-[1.3rem] leading-snug">
            ¿Te interesa esta propiedad?
          </p>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-[var(--text-soft)]">
            Te respondemos el mismo día, sin compromiso.
          </p>

          <LeadForm
            propertyUid={detail.uid}
            propertyName={detail.name}
            agentRef={agente?.email || agente?.uid || ''}
            formName="ficha-propiedad"
          />

          {/*
            WhatsApp retirado a propósito, no por descuido.

            Un enlace a wa.me abre una conversación que no pasa por ningún
            sistema: no queda registrada, no se asigna a nadie y no se puede
            medir. Con un solo número, además, todo cae en el mismo teléfono.
            Se reactivará cuando exista el reparto por turnos (round robin),
            de forma que cada clic quede registrado y asignado.

            Mientras tanto el formulario es la única vía desde la ficha, y esa
            sí deja rastro.
          */}
        </div>
      </aside>
    </section>

    {
      similares.length > 0 && (
        <section class="container-x mt-28">
          <h2 class="text-[1.8rem]">Propiedades similares</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {similares.map((p) => (
              <PropertyCard property={p} tasa={tasaFicha} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
