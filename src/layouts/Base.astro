---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string | null;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = null,
  type = 'website',
  noindex = false,
  schema,
} = Astro.props;

// Vercel ya normaliza la barra final, así que basta con la URL absoluta.
// Antes había aquí un .replace(/(.+)\/$/, '$1/') que sustituye una cadena por
// sí misma: sugería una protección que no existía.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : new URL('/og-default.jpg', Astro.site).href;
const fullTitle = title.includes('Villanisa') ? title : `${title} | Villanisa`;

// La organización se declara en todas las páginas: es lo que ata el sitio
// a la ficha de empresa en Google.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': 'https://villanisa.com.do/#organization',
  name: 'Villanisa',
  url: 'https://villanisa.com.do',
  telephone: '+1-809-328-3379',
  // Google usa este logo en el panel de conocimiento y en resultados de marca
  logo: 'https://villanisa.com.do/logo-villanisa@2x.webp',
  image: 'https://villanisa.com.do/og-default.jpg',
  email: 'recepcion@villanisa.com.do',
  areaServed: { '@type': 'Country', name: 'República Dominicana' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle General Carlos Hernández #67, Los Prados',
    addressLocality: 'Santo Domingo',
    addressCountry: 'DO',
  },
  sameAs: [
    'https://www.facebook.com/VillanisaRD/',
    'https://www.instagram.com/villanisard/',
  ],
};

const schemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="es-DO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Villanisa" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#1f6b52" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icono-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Precarga del CDN de imágenes. Antes apuntaba a secure.alterestate.com,
         que solo se consulta al construir el sitio: era una conexión de más
         que no ahorraba nada. Las fotos salen de este host. -->
    <link rel="preconnect" href="https://d2kflbb1pmooh4.cloudfront.net" crossorigin />

    {/*
      Se escapa el '<' antes de meter el JSON en el HTML.

      JSON.stringify no escapa '/', así que un nombre de propiedad del CRM que
      contuviera "</script>" cerraría la etiqueta y el resto del nombre se
      ejecutaría como código. Los nombres los escriben los asesores y llegan
      sin filtrar: hoy ninguno tiene '<', pero el día que uno lo tenga esto
      sería ejecución de script en todas las fichas de esa zona.
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')}
      is:inline
    />
  </head>

  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-full focus:bg-[var(--color-brand-500)] focus:px-5 focus:py-3 focus:text-white">
      Saltar al contenido
    </a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Revelado progresivo. 12 líneas en lugar de una librería de animación.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
