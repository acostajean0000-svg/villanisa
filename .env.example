# Dominio que identifica la empresa ante la API de AlterEstate (lectura)
ALTERESTATE_DOMAIN=villanisainmobiliaria.com

# API key privada para enviar leads al CRM. Solo en el servidor.
ALTERESTATE_API_KEY=

# Acceso al panel interno en /panel
PANEL_USUARIO=villanisa
PANEL_CLAVE=

# Almacen de contenido propio (lo crea Vercel al añadir un Blob store)
BLOB_READ_WRITE_TOKEN=
# Deploy Hook para republicar tras guardar textos
DEPLOY_HOOK_URL=
