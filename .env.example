# Dominio que identifica la empresa ante la API de AlterEstate (lectura)
ALTERESTATE_DOMAIN=villanisainmobiliaria.com

# --- Lectura del inventario -------------------------------------------------
# No hace falta clave: la API identifica a la empresa por la cabecera `domain`.

# --- Panel interno (/panel y /api/contenido) --------------------------------
PANEL_USUARIO=villanisa
PANEL_CLAVE=                      # marcar como Sensitive en Vercel

# --- Contenido propio -------------------------------------------------------
BLOB_READ_WRITE_TOKEN=            # lo inyecta Vercel al conectar el Blob store
DEPLOY_HOOK_URL=                  # republica el sitio al guardar un texto

# --- Envío de leads al CRM --------------------------------------------------
ALTERESTATE_API_KEY=              # Sensitive. Perfil del usuario en AlterEstate
ALTERESTATE_ROUND_ROBIN_UID=      # UID de la regla de reparto del sitio.
                                  # SIN esto, todo lead sin asesor cae en el
                                  # dueño de la clave.
ALTERESTATE_VIA_ID=               # ID de la vía "Villanisa.com.do". Sin esto
                                  # los leads del sitio se mezclan con los del
                                  # otro sitio y no se pueden comparar.
